 },
 "script_source": "\"\"\"Multi-seed robustness of the pre-registered t_good sweep (NOT pre-registered; information only).\nRuns src/beans_v2/threshold_sweep.py's own build_trays()/score()/verdict() from the saved fold predictions,\nchanging only the two tray-draw seeds: 20261004 -> 1000+s and 2026 -> 5000+s for s = 1..20\n(the same seeds as the independent regression check of 4 Oct). Seed 0 = the pre-registered draw (must give 16/1/0).\"\"\"\nimport json, sys, time\nfrom pathlib import Path\nROOT = Path(\"<project root>\")\nsys.path.insert(0, str(ROOT / \"src/beans_v2\"))\nimport numpy as np\nimport threshold_sweep as ts\n\n_orig = np.random.default_rng\ndef run(s):\n    def patched(seed=None):\n        if s == 0: return _orig(seed)\n        return _orig({20261004: 1000 + s, 2026: 5000 + s}[seed])\n    np.random.default_rng = patched\n    try:\n        units = ts.build_trays()\n    finally:\n        np.random.default_rng = _orig\n    T = ts.cc.deployed()[0]\n    per_t = {f\"{tg:.2f}\": ts.score(units, T, tg) for tg in ts.CANDIDATES}\n    rows, chosen = ts.verdict(per_t)\n    return units, per_t, rows, chosen\n\nt0 = time.strftime(\"%Y-%m-%d %H:%M:%S %Z\")\nseeds = {}\nfor s in range(0, 21):\n    units, per_t, rows, chosen = run(s)\n    rec = {\"tray_seeds\": \"pre-registered (20261004, 2026)\" if s == 0 else [1000 + s, 5000 + s], \"chosen_t_good\": chosen,\n           \"per_t_good\": {}}\n    for k, r in per_t.items():\n        rec[\"per_t_good\"][k] = {\"bands\": rows[k][\"bands_total\"], \"wrong\": rows[k][\"wrong_total\"],\n                                \"dangerous\": rows[k][\"dangerous_total\"], \"units_failing_5pct_rule\": rows[k][\"units_failing_b\"],\n                                \"per_unit\": {u: {\"bands\": v[\"bands\"], \"wrong\": v[\"wrong\"], \"dangerous\": v[\"dangerous\"]}\n                                             for u, v in r.items() if v[\"bands\"]}}\n    seeds[str(s)] = rec\n    p = rec[\"per_t_good\"][\"0.55\"][\"per_unit\"]\n    print(s, chosen, {u: (v[\"bands\"], v[\"wrong\"]) for u, v in p.items()}, flush=True)\n\ndef agg(tg, unit=None):\n    b = w = d = 0\n    for s in range(1, 21):\n        r = seeds[str(s)][\"per_t_good\"][tg]\n        if unit is None: b += r[\"bands\"]; w += r[\"wrong\"]; d += r[\"dangerous\"]\n        else:\n            v = r[\"per_unit\"].get(unit, {\"bands\": 0, \"wrong\": 0, \"dangerous\": 0}); b += v[\"bands\"]; w += v[\"wrong\"]; d += v[\"dangerous\"]\n    return {\"bands\": b, \"wrong\": w, \"dangerous\": d, \"wrong_share\": round(w / b, 4) if b else None}\n\nsummary = {\"seeds\": \"1..20 (not the pre-registered draw)\",\n           \"trays_per_seed\": sum(len(u[\"trays\"]) for u in units),\n           \"chosen_t_good_counts\": {str(c): sum(1 for s in range(1, 21) if seeds[str(s)][\"chosen_t_good\"] == c)\n                                    for c in sorted({seeds[str(s)][\"chosen_t_good\"] for s in range(1, 21)})},\n           \"dangerous_any_seed_any_candidate\": sum(seeds[str(s)][\"per_t_good\"][k][\"dangerous\"] for s in range(1, 21) for k in seeds[str(s)][\"per_t_good\"]),\n           \"all_units\": {tg: agg(tg) for tg in (\"0.50\", \"0.55\", \"0.60\")},\n           \"samruddh_grading\": {tg: agg(tg, \"samruddh_grading\") for tg in (\"0.50\", \"0.55\", \"0.60\")},\n           \"j4ckdev_1200_auditor\": {tg: agg(tg, \"j4ckdev_1200_auditor\") for tg in (\"0.50\", \"0.55\", \"0.60\")}}\nout = {\"what\": \"Multi-seed robustness of the t_good sweep. NOT pre-registered; information only. The shipped threshold (0.55) \"\n               \"was chosen on seed 0 (the pre-registered draw) and is unchanged.\",\n       \"method\": \"src/beans_v2/threshold_sweep.py build_trays()/score()/verdict() on the saved fold predictions, shipped T and \"\n                 \"t_defect 0.91; only the two tray-draw seeds change (20261004 -> 1000+s, 2026 -> 5000+s). \"\n                 \"To reproduce one seed, edit those two default_rng() seeds in threshold_sweep.py.\",\n       \"run_started\": t0, \"run_finished\": time.strftime(\"%Y-%m-%d %H:%M:%S %Z\"),\n       \"summary_seeds_1_to_20\": summary, \"per_seed\": seeds}\njson.dump(out, open(ROOT / \"reports_v2/threshold_seeds.json\", \"w\"), indent=1, default=lambda o: o.item() if hasattr(o, \"item\") else str(o))\nprint(json.dumps(summary, indent=1))\n"
}