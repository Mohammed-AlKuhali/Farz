{
  "name": "farz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-ort.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ort.mjs",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4180 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "../.venv/bin/python tests/make_fixtures.py",
    "icons": "node scripts/make-icons.mjs",
    "audio:placeholders": "bash scripts/make_placeholder_audio.sh"
  },
  "dependencies": {
    "@fontsource/noto-naskh-arabic": "5.3.0",
    "@fontsource/reem-kufi": "5.3.0",
    "onnxruntime-web": "1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3",
    "workbox-window": "7.4.1"
  }
